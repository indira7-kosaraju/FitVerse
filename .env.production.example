# Copy to .env.production (never commit it) or set these in your host's dashboard.
NODE_ENV=production
PORT=8080

# MongoDB Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fitverse?retryWrites=true&w=majority
# (docker-compose.yml overrides this to use its bundled MongoDB.)
MONGO_URI=

# Two different random values, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public URL of the site (used in password-reset links).
CLIENT_URL=https://your-domain.com

# Number of reverse proxies in front of the app (Render/Railway/Fly/Caddy/nginx: 1).
TRUST_PROXY=1

# Only for a split deployment where the frontend is on a different origin:
# CLIENT_ORIGIN=https://app.your-domain.com
# COOKIE_SAMESITE=none
