PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/fitverse
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Frontend origin(s), comma-separated. Only needed if the frontend is not served through the /api proxy.
CLIENT_ORIGIN=http://localhost:5173
# Used to build password reset links (logged to the console; no email provider is configured).
CLIENT_URL=http://localhost:5173
